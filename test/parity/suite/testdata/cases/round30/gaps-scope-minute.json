{
 "about": "A permission scope PIP without cachePeriod, read by an iterating set twice, 61 s apart. Round 29 saw its answer served from the cache 5 s later. pipCalls records the calls to the scope route: 1 and 1 if the answer lives a minute, 1 and 0 if it lives longer.",
 "resourceTypePrefix": "PARITY_SUITE_R30G_",
 "pins": {
  "/api/v1/permission-scope/user/00000000-0000-0000-0000-000000003003/policies": {
   "statusCode": 200,
   "body": {
    "permissionScope": [
     {
      "id": "00000000-0000-0000-0000-000000003003",
      "isInherited": false,
      "name": "parity-r30-scope",
      "type": "USER",
      "policies": [
       {
        "scopeItems": [
         {
          "key": "region",
          "values": [
           {
            "id": "v"
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  }
 },
 "pips": {
  "scope": {
   "name": "subject.permissionScope",
   "pipType": "PERMISSION_SCOPE",
   "url": "http://pip-mock:8090"
  }
 },
 "cases": [
  {
   "id": "r30gaps-scope-minute-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r30",
      "c": "n"
     },
     "subject": "user:parity-r30-scope"
    }
   ]
  },
  {
   "id": "r30gaps-scope-without-period-after-a-minute",
   "pips": [
    "scope"
   ],
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "pol",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "probe",
         "target": "true",
         "condition": "subject.permissionScope.region CONTAINS 'v' OR resource.a == 'y'",
         "effect": "ALLOW"
        }
       ]
      }
     ],
     "iterate": {
      "foreach": "subject.permissionScope",
      "algorithm": "DENY_UNLESS_PERMIT"
     }
    }
   ],
   "about": "The scope PIP has no cachePeriod.",
   "requests": [
    {
     "name": "first",
     "resource": {
      "id": "r30",
      "a": "n"
     },
     "pipCalls": "/api/v1/permission-scope/user/00000000-0000-0000-0000-000000003003/policies",
     "subject": "user:parity-r30-scope"
    },
    {
     "name": "after-61s",
     "resource": {
      "id": "r30",
      "a": "n"
     },
     "pipCalls": "/api/v1/permission-scope/user/00000000-0000-0000-0000-000000003003/policies",
     "pauseMs": 61000,
     "subject": "user:parity-r30-scope"
    }
   ]
  },
  {
