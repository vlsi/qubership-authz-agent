  {
   "id": "r63ob-should-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r33",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "r63ob-check-token",
   "about": "The only set that allows VIEW_AS_ANOTHER_USER reads the caller's department through a TOKEN PIP (LI-10): the reader passes when the check reads the caller's token, and gets false when the check reads TOKEN as empty, as the decision for the user does.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "anyone",
       "target": "true",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "read",
         "target": "operation == 'READ'",
         "condition": "true",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    },
    {
     "key": "authorize",
     "target": "resourceType == 'OnBehalfOfUserAuthorization'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "view-as",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "view",
         "target": "operation == 'VIEW_AS_ANOTHER_USER'",
         "condition": "subject.parityOnBehalfDepartment == 'finance'",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    }
   ],
