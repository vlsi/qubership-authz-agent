generated_roles(prefix, start, finish) := [sprintf("%v%03d", [prefix, idx]) |
  idx := numbers.range(start, finish)[_]
]

# ── ADR-0046: Canonical-only subject contract ──────────────────────────────

test_subject_contains_only_canonical_fields if {
  token := sprintf("Bearer %v", [fixtures.tokens.valid])
  auth := data.identity.authenticate({"subject": token}) with data.authn as fixtures.authn
  auth.authenticated

  subject_keys := object.keys(auth.subject)
  canonical_keys := {"id", "name", "type", "roles", "scopes"}
  extra_keys := {k | k := subject_keys[_]; not canonical_keys[k]}
  print({"extra_keys_in_subject": extra_keys})
  count(extra_keys) == 0
}

test_subject_from_cached_verification_contains_only_canonical_fields if {
  cached_token := "cached-token-extra-claims"
  cached_authn := {
    "verifiedTokens": {
      cached_token: {
        "providerId": "cached-idp",
        "subject": {
          "id": "cached-user",
          "name": "cached-user",
          "type": "USER",
          "roles": ["ROLE_VIEWER"],
          "scopes": ["openid"],
          "email": "cached@test.local",
          "department": "engineering"
        },
        "payload": {
          "sub": "cached-user",
          "preferred_username": "cached-user",
          "realm_access": {"roles": ["ROLE_VIEWER"]},
          "email": "cached@test.local",
          "department": "engineering"
        }
      }
    }
  }

  auth := data.identity.authenticate({"subject": sprintf("Bearer %v", [cached_token])}) with data.authn as cached_authn
  auth.authenticated

  subject_keys := object.keys(auth.subject)
  canonical_keys := {"id", "name", "type", "roles", "scopes"}
  extra_keys := {k | k := subject_keys[_]; not canonical_keys[k]}
  print({"extra_keys_in_cached_subject": extra_keys})
  count(extra_keys) == 0
}

test_authenticate_returns_token_payload if {
  token := sprintf("Bearer %v", [fixtures.tokens.valid])
  auth := data.identity.authenticate({"subject": token}) with data.authn as fixtures.authn
  auth.authenticated

  payload := object.get(auth, "tokenPayload", {})
  count(object.keys(payload)) > 0
  payload.sub == "user-allow"
}

# ── ADR-0046: TOKEN PIP end-to-end authorization tests ─────────────────────
