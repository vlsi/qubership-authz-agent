    "ignoreRls": true
  }

  actual := data.authorize_internals.admission
    with input as input_req
    with data.authn as fixtures.authn

  not object.get(actual, "authError", false)
  actual.subjectError
}

# ── realm_access.roles positive cases ────────────────────────────────────

test_token_auth_realm_access_roles_are_used if {
  payload := {
    "realm_access": {
      "roles": ["ROLE_VIEWER", "ROLE_EDITOR"]
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 2
  roles[0] == "ROLE_EDITOR"
  roles[1] == "ROLE_VIEWER"
}

test_token_auth_realm_access_roles_are_case_normalized if {
  payload := {
    "realm_access": {
      "roles": ["role_viewer", "Role_Editor"]
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 2
  roles[0] == "ROLE_EDITOR"
  roles[1] == "ROLE_VIEWER"
}

# ── ignored non-realm claim negative cases ───────────────────────────────

test_token_auth_groups_without_realm_access_gives_no_roles if {
  payload := {
    "groups": ["ROLE_ADMINISTRATOR", "ROLE_VIEWER"]
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 0
}

test_token_auth_direct_roles_without_realm_access_gives_no_roles if {
  payload := {
    "roles": ["ROLE_ADMINISTRATOR", "ROLE_VIEWER"]
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 0
}

test_token_auth_authorities_without_realm_access_gives_no_roles if {
  payload := {
    "authorities": ["ROLE_ADMINISTRATOR", "ROLE_VIEWER"]
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 0
}

test_token_auth_resource_access_without_realm_access_gives_no_roles if {
  payload := {
    "resource_access": {
      "portal": {
        "roles": ["ROLE_ADMINISTRATOR", "ROLE_VIEWER"]
      }
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 0
}

test_token_auth_all_non_realm_claims_without_realm_access_gives_no_roles if {
  payload := {
    "roles": ["ROLE_VIEWER"],
    "authorities": ["ROLE_VIEWER"],
    "groups": ["ROLE_VIEWER"],
    "resource_access": {
      "portal": {
        "roles": ["ROLE_VIEWER"]
      }
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 0
}

test_token_auth_empty_realm_access_roles_gives_no_roles if {
  payload := {
    "realm_access": {
      "roles": []
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 0
}

test_token_auth_missing_realm_access_gives_no_roles if {
  payload := {}
  roles := data.identity.payload_roles(payload)
  count(roles) == 0
}

test_token_auth_non_realm_claims_ignored_even_when_realm_access_present if {
  payload := {
    "roles": ["ROLE_EXTRA_DIRECT"],
    "authorities": ["ROLE_EXTRA_AUTHORITY"],
    "groups": ["ROLE_EXTRA_GROUP"],
    "resource_access": {
      "portal": {
        "roles": ["ROLE_EXTRA_SERVICE"]
      }
    },
    "realm_access": {
      "roles": ["ROLE_VIEWER"]
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 1
  roles[0] == "ROLE_VIEWER"
}

